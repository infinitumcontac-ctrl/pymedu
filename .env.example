# ============================================
# PymEdu - Variables de Entorno (Ejemplo)
# ============================================

# Frontend (Vite)
VITE_API_URL=http://localhost:3001

# Backend API
API_PORT=3001

# Supabase - CONEXION DEL FRONTEND
# Obtener en: Supabase Dashboard > Settings > API
#   Project URL  -> VITE_SUPABASE_URL
#   anon public  -> VITE_SUPABASE_ANON_KEY
VITE_SUPABASE_URL="https://tu-proyecto.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJ...tu-anon-key..."

# ============================================
# Transbank Webpay Plus (pagos de suscripcion)
# https://www.transbankdevelopers.cl/referencia/webpay
# Por defecto usa el AMBIENTE DE INTEGRACION (tarjetas de prueba).
# ============================================
TBK_ENV=integracion
TBK_COMMERCE_CODE=597055555532
TBK_API_KEY_SECRET=579B532A7440BB0C9079DED94D31EA1615BACEB56610332264630D42D0A36B1C

# URL del frontend a la que Webpay devuelve al usuario tras pagar
FRONT_URL=http://localhost:3000
# URL publica de esta API (recibe el retorno POST de Transbank)
API_PUBLIC_URL=http://localhost:4000

# ============================================
# Supabase - ACTIVACION AUTOMATICA DE MEMBRESIA
# La clave service_role es SECRETA: solo usarla en el backend.
# Si se deja vacia, el pago se registra pero la membresia no cambia sola.
# ============================================
